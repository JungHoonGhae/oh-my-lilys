{
  "name": "oh-my-lilys",
  "version": "1.1.1",
  "description": "CLI tool for lilys.ai - Summarize YouTube, PDF, websites, and audio",
  "type": "module",
  "bin": {
    "lilys": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "build:prepare": "bun run scripts/prebuild.ts",
    "build": "bun run build:prepare && bun build src/index.ts --outdir ./dist --target node",
    "prepublishOnly": "bun run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "keywords": [
    "cli",
    "lilys",
    "ai",
    "summarizer",
    "youtube",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "packageManager": "bun@1.2.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JungHoonGhae/oh-my-lilys.git"
  },
  "bugs": {
    "url": "https://github.com/JungHoonGhae/oh-my-lilys/issues"
  },
  "homepage": "https://github.com/JungHoonGhae/oh-my-lilys#readme"
}
